    <!-- Welcome guide -->
    <string name="guia_saltar">Skip</string>
    <string name="guia_seguinte">Next</string>
    <string name="guia_comecar">Start</string>
    <string name="guia_1_titulo">bruma</string>
    <string name="guia_1_texto">A browser for one hand.\n\nTor built in, with no other app needed, and the real uBlock Origin blocking ads and trackers.</string>
    <string name="guia_2_titulo">The capsule</string>
    <string name="guia_2_texto">There is no bar at the top or the bottom. There is a capsule on the side of your hand, at thumb height.\n\nThe dot on top tells you everything: purple is Tor on, grey is an encrypted connection, red is no encryption.</string>
    <string name="guia_3_titulo">The gestures</string>
    <string name="guia_3_texto">Tap to open the address box.\n\nDrag up or down to switch tabs.\n\nDrag inwards for the actions. Drag outwards to hide the capsule and read with nothing in the way.</string>
    <string name="guia_4_titulo">Tor</string>
    <string name="guia_4_texto">The shield in the actions turns Tor on. From then on traffic leaves through the Tor network, .onion addresses work, and searches go through DuckDuckGo onion.\n\nThis is not the Tor Browser: it hides where you are, but it does not make you look like everyone else.</string>

