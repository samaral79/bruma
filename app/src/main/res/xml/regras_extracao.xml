<?xml version="1.0" encoding="utf-8"?>
<!-- Nada desta app sai para cópias de segurança na nuvem: cookies, sessões e o
     diretório de trabalho do tor não têm que ir parar a um servidor. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /></cloud-backup>
    <device-transfer><exclude domain="root" path="." /></device-transfer>
</data-extraction-rules>
